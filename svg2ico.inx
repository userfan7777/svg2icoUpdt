<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Export as Windows Icon (.ico)</name>
  <id>org.inkscape.output.svg2ico</id>

  <param name="tab" type="notebook">
    <page name="options" gui-text="Opciones">
      <param name="sizes" type="string" gui-text="Tamaños (px, separados por coma)">256,128,64,48,32,16</param>
      <param name="dpi" type="int" min="32" max="2400" gui-text="Resolución de renderizado (DPI)">96</param>
    </page>
    <page name="help" gui-text="Ayuda">
      <label>Exporta el dibujo actual de Inkscape como un archivo .ico de Windows con múltiples tamaños incrustados.

Escribe los tamaños deseados separados por coma, por ejemplo: 256,128,64,48,32,16

Se recomienda que el documento tenga un lienzo cuadrado.</label>
    </page>
  </param>

  <output>
    <extension>.ico</extension>
    <mimetype>image/x-icon</mimetype>
    <filetypename>Windows Icon (*.ico)</filetypename>
    <filetypetooltip>Exportar a formato de icono de Windows</filetypetooltip>
    <dataloss>true</dataloss>
  </output>

  <script>
    <command location="inx" interpreter="python">svg2ico.py</command>
  </script>
</inkscape-extension>
